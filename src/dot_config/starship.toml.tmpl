"$schema" = "https://starship.rs/config-schema.json"

command_timeout = 2000
palette = "kanso_ink"
add_newline = true

format = """$directory$character"""

right_format = """$git_branch$git_state$git_status"""

# ------------------
# Row 1 - Identity / Directory
# ------------------
[username]
show_always = false
disabled = true

[hostname]
ssh_only = true
ssh_symbol = " "
disabled = true

[directory]
style = "muted dimmed"
format = "[$path]($style)[$read_only]($read_only_style) "
truncate_to_repo = true
fish_style_pwd_dir_length = 1
use_logical_path = true
use_os_path_sep = true
truncation_length = 3
truncation_symbol = "../"
read_only = " "
read_only_style = "red"

[directory.substitutions]
"~/.local/share/chezmoi" = " [Chezmoi]"
"~/.config" = " [XDG Config]"

[buf]
disabled = true

[bun]
symbol = " "

[character]
error_symbol = "[󰘧](bold red)"
success_symbol = "[󰘧](bold green)"

[dotnet]
symbol = " "
version_format = "v${major}.${minor}"
format = "[$symbol($version )(\\( $tfm \\))]($style)"

[git_branch]
symbol = " "
style = "fg:blue"
truncation_length = 18
format = "[ $symbol$branch ]($style)"

[git_commit]
commit_hash_length = 5
style = "fg:green"
format = '[](fg:red)[\($hash$tag\)]($style)'

[git_metrics]
added_style = "fg:green bg:overlay"
deleted_style = "fg:red bg:overlay"
format = "([+$added]($added_style) )([-$deleted]($deleted_style) )"

[git_state]
format = "$conflicted$deleted$renamed$modified$typechanged$staged$untracked"

[git_status]
ahead = "⇡${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
behind = "⇣${count}"
modified = "[  ](fg:bright_yellow bold)"
staged = "[ 󰆣 ](fg:bright_green bold)"
untracked = "[ 󰽅 ](fg:bright_red bold)"
stashed = ""
format = "([$all_status$ahead_behind]($style) )"

[gcloud]
disabled = true

[golang]
symbol = " "

[lua]
symbol = " "

[nix_shell]
symbol = " "
disabled = true

[python]
symbol = " "

[mise]
symbol = " "

[nodejs]
# Only show Node for actual Node projects. This avoids unnecessary `node
# --version` calls in repos that just happen to contain JS/TS files.
detect_extensions = []
detect_files = ["package.json", ".node-version", ".nvmrc", ".tool-versions"]
detect_folders = ["node_modules"]

[os]
disabled = true

[package]
disabled = true

[time]

[palettes.kanso_ink]
bg = "#14171d"
overlay = "#3e424a"
fg = "#c5c9c7"
muted = "#a4a7a4"
red = "#c4746e"
green = "#8a9a7b"
yellow = "#c4b28a"
blue = "#8ba4b0"
purple = "#a292a3"
cyan = "#8ea4a2"
bright_red = "#e46876"
bright_green = "#87a987"
bright_yellow = "#e6c384"
bright_blue = "#7fb4ca"
bright_purple = "#938aa9"
bright_cyan = "#7aa89f"
