{{- $hostname := lower (first (splitList "." .chezmoi.hostname)) -}}
{{- $host := get .onepassword.hosts $hostname -}}
{{- if not $host -}}
{{- fail (printf "No 1Password Environment configured for hostname %q" .chezmoi.hostname) -}}
{{- end -}}
{{- $environmentID := get $host "environment" -}}
{{- $auth := get $host "auth" -}}
{{- if not (regexMatch "^[a-z0-9]{26}$" $environmentID) -}}
{{- fail (printf "Invalid 1Password Environment ID for hostname %q" $hostname) -}}
{{- end -}}
{{- if not (has $auth (list "desktop" "service-account")) -}}
{{- fail (printf "Unsupported 1Password authentication method for hostname %q" $hostname) -}}
{{- end -}}
{{ if eq $auth "service-account" -}}
# Provision this token outside chezmoi; never store it in dotfiles.
if not set -q OP_SERVICE_ACCOUNT_TOKEN; and test -s "$HOME/.config/op/service-account-token"
    read -gx OP_SERVICE_ACCOUNT_TOKEN < "$HOME/.config/op/service-account-token"
end
{{ end }}
# Automation inherits its environment or uses op run explicitly.
status is-interactive; or return

if set -q fish_trace; and test -n "$fish_trace"
    echo "1Password Environment not loaded: disable fish_trace before loading secrets." >&2
    return 1
end

if not command -q op
    echo "1Password Environment not loaded: run mise install first." >&2
    return 1
end

{{ if eq $auth "desktop" -}}
# Desktop authentication, even if the parent exported server credentials.
set -l op_command env -u OP_SERVICE_ACCOUNT_TOKEN -u OP_CONNECT_HOST -u OP_CONNECT_TOKEN op
{{ else -}}
set -l op_command op
{{ end -}}
# NUL separators preserve newlines, quotes and shell syntax as literal data.
# Compare against inherited exports so existing Fish arrays are left intact.
set -l op_before (command /usr/bin/env -0 | string split0)
set -l op_before_status $pipestatus
if not string match -q '0 0' -- "$op_before_status"
    echo "1Password Environment not loaded: could not capture existing exports." >&2
    return 1
end
set -l op_environment (command $op_command run --environment {{ $environmentID }} --no-masking -- /usr/bin/env -0 </dev/null 2>/dev/null | string split0)
set -l op_environment_status $pipestatus
if not string match -q '0 0' -- "$op_environment_status"
    echo "1Password Environment not loaded: check beta CLI authentication and access to {{ $environmentID }}." >&2
    return 1
end

# Reject Fish-controlled names before importing anything. fish_trace would log
# later assignments; umask has additional value constraints, so leave it to Fish.
set -l op_reserved _ fish_kill_signal fish_killring fish_pid fish_terminal_color_theme history hostname PWD pipestatus SHLVL status status_generation version FISH_VERSION umask fish_trace
# Validate names before changing the shell environment. Never eval secret values.
for entry in $op_environment
    contains -- "$entry" $op_before; and continue
    if not string match -rq '^[A-Za-z_][A-Za-z0-9_]*=' -- "$entry"
        echo "1Password Environment not loaded: invalid environment variable name." >&2
        return 1
    end
    set -l pair (string split -m1 '=' -- "$entry")
    if contains -- "$pair[1]" $op_reserved
        echo "1Password Environment not loaded: variable name is reserved by Fish." >&2
        return 1
    end
end
for entry in $op_environment
    if not contains -- "$entry" $op_before
        set -l pair (string split -m1 '=' -- "$entry")
        set -gx -- $pair[1] "$pair[2]"; or return 1
    end
end
