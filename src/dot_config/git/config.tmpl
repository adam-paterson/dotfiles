# Portable Git defaults managed by chezmoi.
# Machine/vendor/generated overrides belong in ~/.config/git/local.gitconfig,
# included by ~/.gitconfig after this XDG config has loaded.

[alias]
	br = branch
	ci = commit
	co = checkout
	last = log -1 HEAD
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	st = status -sb
	unstage = reset HEAD --
  dlog = -c 'diff.external=difft --display=side-by-side-show-both' log --ext-diff
  dshow = -c 'diff.external=difft --display=side-by-side-show-both' show --ext-diff
  ddiff = -c 'diff.external=difft --display=side-by-side-show-both' diff
  dl = -c 'diff.external=difft --display=side-by-side-show-both' log -p --ext-diff
  ds = -c 'diff.external=difft --display=side-by-side-show-both' show --ext-diff
  dft = -c 'diff.external=difft --display=side-by-side-show-both' diff

[color]
	ui = true

[core]
	editor = nvim
	longpaths = true
	excludesFile = ~/.config/git/ignore
	pager = less -R

[pager]
  difftool = true

[delta]
	dark = true
	features = catppuccin-mocha
	hyperlinks = true
	line-numbers = true
	navigate = true
	side-by-side = true

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
	program = {{ if eq .chezmoi.os "darwin" }}/Applications/1Password.app/Contents/MacOS/op-ssh-sign{{ else }}ssh-keygen{{ end }}

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[diff]
  external = difft --display=side-by-side-show-both
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft --display=side-by-side-show-both "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[merge]
	autoStash = true
	conflictStyle = zdiff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[tag]
	gpgSign = true

[user]
	email = hello@adampaterson.co.uk
	name = Adam Paterson
	signingKey = {{ if eq (first (splitList "." (lower .chezmoi.hostname))) "seraph" }}"{{ .chezmoi.homeDir }}/.ssh/id_ed25519"{{ else }}ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL1CJVWAx5tlEl1onIshZURohd68JMza5uk1E+eStOUn{{ end }}
