{{- $user := "adampaterson" -}}

[merge]
  command = "nvim"
  args = [
    "-d",
    "{{ "{{" }} .Destination {{ "}}" }}",
    "{{ "{{" }} .Source {{ "}}" }}",
    "{{ "{{" }} .Target {{ "}}" }}",
  ]

[git]
  autoAdd = true
  autoCommit = false

[diff]
  command = "difft"
  args = ["--display=side-by-side-show-both", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
  pager = "less -R"

format = "json"
mode = "file"

[update]
  recurseSubmodules = true

[onepassword]
  cache = true
