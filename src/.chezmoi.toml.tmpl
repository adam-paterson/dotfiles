{{- $headless := promptBoolOnce . "headless" "Headless machine" false -}}
{{- $gitSigningKey := promptStringOnce . "gitSigningKey" "Git signing key (public key or private-key path)" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL1CJVWAx5tlEl1onIshZURohd68JMza5uk1E+eStOUn" -}}
{{- $gitSigningPublicKey := promptStringOnce . "gitSigningPublicKey" "Git signing public key" -}}

[merge]
  command = "nvim"
  args = [
    "-d",
    "{{ "{{" }} .Destination {{ "}}" }}",
    "{{ "{{" }} .Source {{ "}}" }}",
    "{{ "{{" }} .Target {{ "}}" }}",
  ]

[git]
  autoAdd = true
  autoCommit = false

[diff]
  command = "difft"
  args = ["--display=side-by-side-show-both", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
  pager = "less -R"

format = "json"
mode = "file"

[update]
  recurseSubmodules = true

[onepassword]
  cache = true

[data]
  headless = {{ $headless }}
  gitSigningKey = {{ $gitSigningKey | quote }}
  gitSigningPublicKey = {{ $gitSigningPublicKey | quote }}
