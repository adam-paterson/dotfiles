{
  "$schema": "https://raw.githubusercontent.com/openclaw/mcporter/refs/heads/main/mcporter.schema.json",
  "imports": [], // Keep imports empty to ensure servers are implicit
  "mcpServers": {
    "codeSearch": {
      "baseUrl": "https://mcp.grep.app",
      "lifecycle": "keep-alive"
    },
    "google-ads": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "git+https://github.com/googleads/google-ads-mcp.git",
        "google-ads-mcp"
      ],
      "env": {
        "GOOGLE_PROJECT_ID": "thrive-seo",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${HOME}/.config/gcloud/application_default_credentials.json",
        "GRPC_DNS_RESOLVER": "native"
      }
    },
    "aside-browser": {
      "command": "aside",
      "args": [
        "mcp"
      ]
    },
    "computer": {
      "command": "cua-driver",
      "args": [
        "mcp"
      ]
    },
    "artifacts": {
      "baseUrl": "https://artifacts.adampaterson.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${ARTIFACT_SERVER_AGENT_TOKEN}"
      },
      "env": {
        "ARTIFACT_SERVER_AGENT_TOKEN": "${ARTIFACT_SERVER_AGENT_TOKEN}"
      }
    }
  }
}
