{{- if eq .chezmoi.os "darwin" }}
[tools]
# Node.js (used for global JS CLIs via npm/npx)
node = "lts"

# Terraform (replaces tenv)
terraform = "latest"

# Python (for tools that need it)
python = "3.12"

# uv (Python package manager)
uv = "latest"

# Poetry (Python dependency manager, via pipx/uvx)
"pipx:poetry" = "latest"

# pre-commit (Git hook framework)
"pipx:pre-commit" = "latest"

# Go
go = "latest"

# Rust
rust = "latest"

# oh-my-opencode CLI
"npm:oh-my-opencode" = "3.5.5"

# HAPI CLI for remote control of local AI coding sessions
"npm:@twsxtd/hapi" = "latest"

# Gemini CLI
"npm:@google/gemini-cli" = "latest"
{{- else }}
[tools]
# On Linux/NixOS, node/python/go/rust come from nix system packages
# Only install terraform and uv via mise
terraform = "latest"
uv = "latest"
{{- end }}

[settings]
auto_install = true
experimental = true
trusted_config_paths = ["~/Projects", "~/Work"]
always_keep_download = false
always_keep_install = false

[env]
_.path = ["./node_modules/.bin", "./bin"]