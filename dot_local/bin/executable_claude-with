#!/usr/bin/env bash
set -euo pipefail

PROVIDER="${1:-anthropic}"
shift 2>/dev/null || true

API_KEY=""
BASE_URL=""

case "$PROVIDER" in
  anthropic)
    BASE_URL="https://api.anthropic.com"
    if command -v op &>/dev/null; then
      API_KEY=$(op read "op://Private/anthropic-api-key/credential" 2>/dev/null) || true
    fi
    if [[ -z "$API_KEY" && -n "${ANTHROPIC_API_KEY:-}" ]]; then
      API_KEY="$ANTHROPIC_API_KEY"
    fi
    ;;
  openrouter)
    BASE_URL="https://openrouter.ai/api/v1"
    if command -v op &>/dev/null; then
      API_KEY=$(op read "op://Private/openrouter-api-key/credential" 2>/dev/null) || true
    fi
    if [[ -z "$API_KEY" && -n "${OPENROUTER_API_KEY:-}" ]]; then
      API_KEY="$OPENROUTER_API_KEY"
    fi
    ;;
  *)
    echo "Usage: claude-with [anthropic|openrouter] [args...]" >&2
    exit 1
    ;;
esac

if [[ -z "$API_KEY" ]]; then
  echo "Error: No API key available for $PROVIDER" >&2
  echo "Set 1Password up or export ${PROVIDER^^}_API_KEY" >&2
  exit 1
fi

ANTHROPIC_API_KEY="$API_KEY" \
ANTHROPIC_BASE_URL="$BASE_URL" \
claude "$@"