#!/usr/bin/env bash
set -euo pipefail

# boot-05: Configure 1Password CLI
# Authenticates op using the service account token from age-encrypted secret.
# After this, onepasswordRead works in chezmoi templates (requires re-apply).

ENCRYPTED_TOKEN="{{ .chezmoi.sourceDir }}/private_dot_config/1password/OP_SERVICE_ACCOUNT_TOKEN.age"
TOKEN_DEST="${XDG_CONFIG_HOME:-$HOME/.config}/1password/OP_SERVICE_ACCOUNT_TOKEN"

echo ":: [boot-05] Configuring 1Password"

if ! command -v op &>/dev/null; then
  echo "    Error: op not found. It should have been installed by aqua."
  echo "    Run 'aqua install' first, then re-apply."
  exit 1
fi

# Check if already authenticated
if op account list 2>/dev/null | grep -q '.'; then
  echo "    1Password already authenticated"
  exit 0
fi

# Try to decrypt the service account token using age
if ! command -v age &>/dev/null; then
  echo "    Error: age not found. Required to decrypt 1Password service account token."
  echo "    Install age via aqua first, then re-apply."
  exit 1
fi

AGE_IDENTITY="${AGE_IDENTITY:-$HOME/.ssh/main}"

if [[ ! -f "$AGE_IDENTITY" ]]; then
  echo "    Error: age identity not found at $AGE_IDENTITY"
  echo "    Provide your SSH key at ~/.ssh/main or set AGE_IDENTITY"
  exit 1
fi

if [[ ! -f "$ENCRYPTED_TOKEN" ]]; then
  echo "    Warning: encrypted service account token not found at $ENCRYPTED_TOKEN"
  echo "    To set up 1Password:"
  echo "      1. Create a 1Password service account at https://my.1password.com/service-accounts/"
  echo "      2. Encrypt the token: echo -n 'YOUR_TOKEN' | age -r \$(cat ~/.ssh/main.pub) -o $ENCRYPTED_TOKEN"
  echo "      3. Re-run chezmoi apply"
  exit 0
fi

echo "    Decrypting service account token..."
mkdir -p "$(dirname "$TOKEN_DEST")"

if age -d -i "$AGE_IDENTITY" "$ENCRYPTED_TOKEN" > "$TOKEN_DEST" 2>/dev/null; then
  chmod 600 "$TOKEN_DEST"
  echo "    Service account token decrypted"
else
  echo "    Error: Failed to decrypt service account token"
  echo "    Check that your age identity ($AGE_IDENTITY) matches the encryption key"
  rm -f "$TOKEN_DEST"
  exit 1
fi

# Authenticate using service account token
echo "    Authenticating 1Password..."
export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$TOKEN_DEST")"

if op whoami &>/dev/null; then
  echo "    1Password authenticated successfully"
  echo ""
  echo "    NOTE: Run 'chezmoi apply' again to populate templates with 1Password secrets."
else
  echo "    Error: 1Password authentication failed"
  echo "    Check that the service account token is valid"
  rm -f "$TOKEN_DEST"
  exit 1
fi