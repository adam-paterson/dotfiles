#!/usr/bin/env bash
set -euo pipefail

echo ":: [01] Preparing and applying NixOS configuration"

# Source nix environment if available (needed if nix not yet in PATH)
{{ include ".chezmoitemplates/shell/source_nix_env.sh" -}}

{{ $flake := joinPath .chezmoi.homeDir "nix-config/flake.nix" -}}
# flake.nix: {{ if stat $flake }}{{ output "sha256sum" $flake | trim }}{{ else }}n/a{{ end }}

NIX_CONFIG_DIR="{{ .chezmoi.homeDir }}/nix-config"
NIXOS_DIR="$NIX_CONFIG_DIR/nixos"
HOSTNAME="{{ .hostname }}"

if [[ ! -d "$NIX_CONFIG_DIR" ]]; then
  echo "    Warning: $NIX_CONFIG_DIR not found, skipping"
  exit 0
fi

if [[ ! -f "$NIX_CONFIG_DIR/flake.nix" ]]; then
  echo "    Warning: flake.nix not found in $NIX_CONFIG_DIR"
  echo "    Run 'chezmoi apply' first to render nix config files"
  exit 0
fi

mkdir -p "$NIXOS_DIR"

# ── hardware-configuration.nix ──────────────────────────────────────────
# This file is machine-specific (boot config, filesystem UUIDs, etc.) and
# MUST come from the running system, never from git.
HW_SRC="/etc/nixos/hardware-configuration.nix"
HW_DST="$NIXOS_DIR/hardware-configuration.nix"

if [[ -f "$HW_SRC" ]]; then
  echo "    Copying hardware-configuration.nix from /etc/nixos/"
  cp "$HW_SRC" "$HW_DST"
  # Verify the copy is valid Nix
  if ! head -1 "$HW_DST" | grep -q '{'; then
    echo "    Error: copied file does not look like valid Nix" >&2
    rm -f "$HW_DST"
    exit 1
  fi
else
  echo "    Error: $HW_SRC not found" >&2
  echo "    On NixOS this file should always exist. Is this really NixOS?" >&2
  exit 1
fi

# ── networking.nix ─────────────────────────────────────────────────────
# This file is machine-specific (IPs, gateway, MAC, routes) and MUST come
# from the running system, never from git.
NET_SRC="/etc/nixos/networking.nix"
NET_DST="$NIXOS_DIR/networking.nix"

if [[ -f "$NET_SRC" ]]; then
  echo "    Copying networking.nix from /etc/nixos/"
  cp "$NET_SRC" "$NET_DST"
  # Verify the copy is valid Nix
  if ! head -1 "$NET_DST" | grep -q '{'; then
    echo "    Error: copied file does not look like valid Nix" >&2
    rm -f "$NET_DST"
    exit 1
  fi
else
  echo "    Warning: $NET_SRC not found" >&2
  echo "    Continuing without networking.nix (may cause network issues)" >&2
fi

# ── Verify all imports exist ────────────────────────────────────────────
MISSING=0
for f in hardware-configuration.nix; do
  if [[ ! -f "$NIXOS_DIR/$f" ]]; then
    echo "    Error: required file $NIXOS_DIR/$f is missing" >&2
    MISSING=1
  fi
done
if [[ "$MISSING" -eq 1 ]]; then
  echo "    Cannot proceed with missing required files" >&2
  exit 1
fi

# ── Ensure git is available (required for Nix flakes) ──────────────────
# git may not be installed yet on a fresh NixOS system (only becomes a
# system package after the first nixos-rebuild switch).  Use nix shell to
# get it temporarily if needed.
if ! command -v git >/dev/null 2>&1; then
  echo "    git not found, entering nix shell with git..."
  # Re-exec this script inside nix shell so git is available for the rest
  nix shell nixpkgs#git --command bash "$0"
  exit $?
fi

# ── nix-config git repo (required for Nix flakes) ──────────────────────
if [[ ! -d "$NIX_CONFIG_DIR/.git" ]]; then
  echo "    Initialising git repo in $NIX_CONFIG_DIR..."
  git init "$NIX_CONFIG_DIR"
  git -C "$NIX_CONFIG_DIR" config commit.gpgsign false
  git -C "$NIX_CONFIG_DIR" config commit.sshsign false
  git -C "$NIX_CONFIG_DIR" add .
  git -C "$NIX_CONFIG_DIR" commit -m "Initial nix-config from chezmoi"
else
  git -C "$NIX_CONFIG_DIR" config commit.gpgsign false
  git -C "$NIX_CONFIG_DIR" config commit.sshsign false
  git -C "$NIX_CONFIG_DIR" add -A
  if ! git -C "$NIX_CONFIG_DIR" diff --cached --quiet 2>/dev/null; then
    git -C "$NIX_CONFIG_DIR" commit -m "Update nix-config from chezmoi" --no-verify
  fi
fi

# ── Apply NixOS configuration ──────────────────────────────────────────
echo "    Switching NixOS configuration..."
sudo nixos-rebuild switch --flake "$NIX_CONFIG_DIR#$HOSTNAME" --show-trace