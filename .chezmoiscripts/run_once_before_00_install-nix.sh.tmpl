#!/usr/bin/env bash
set -euo pipefail

# boot-00: Install Nix (determinate installer, idempotent)
# Runs before file updates so nix is available for subsequent scripts.

echo ":: [boot-00] Installing Nix"

if command -v nix &>/dev/null; then
  echo "    Nix already installed: $(nix --version 2>/dev/null | head -1)"
  exit 0
fi

echo "    Installing Nix via Determinate Systems installer..."

{{- if eq .osid "darwin" }}
curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix | sh -s -- install
{{- else if eq .osid "linux" }}
if command -v systemd &>/dev/null; then
  curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix | sh -s -- install
else
  curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix | sh -s -- install --no-daemon
fi
{{- else }}
echo "    Error: unsupported OS {{ .osid }}" >&2
exit 1
{{- end }}

if ! command -v nix &>/dev/null; then
  echo "    Error: nix installation failed" >&2
  exit 1
fi

echo "    Nix installed: $(nix --version 2>/dev/null | head -1)"
